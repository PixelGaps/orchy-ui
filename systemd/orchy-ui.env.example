# Orchy UI local runtime. No secrets belong here.
# Filled by install-local-socket.sh with the private copied Node.js >=20.19 runtime.
ORCHY_UI_NODE_BIN_DIR=
ORCHY_UI_IDLE_SECONDS=300
ORCHY_UI_DIST_DIR=/var/lib/orchy-ui/current/dist
ORCHY_UI_DEPLOYED_SHA_FILE=/var/lib/orchy-ui/deployed-sha
ORCHY_UI_STATE_DIR=/var/lib/orchy-ui
ORCHY_UI_REPO_DIR=/opt/orchy-ui/source
ORCHY_UI_BRANCH=main
ORCHY_UI_REMOTE_URL=https://github.com/PixelGaps/orchy-ui.git
ORCHY_WEB_API_TARGET=http://127.0.0.1:23235
